{
  "name": "linkmarketing-backend-functions",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "firebase emulators:start --only auth,firestore,functions,storage",
    "test:rules": "firebase emulators:exec --project demo-linkmarketing-local \"npm run test:rules:raw\"",
    "test:rules:raw": "node --test tests/rules-deny-all.test.cjs",
    "seed:emulator": "node scripts/seed-emulator.cjs",
    "reset:emulator": "node scripts/reset-emulator.cjs",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
