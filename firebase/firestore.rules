rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membership(tenantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.active == true;
    }

    function role(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role;
    }

    function agentAssigned(tenantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/agentUsers/$(request.auth.uid)/assignments/$(tenantId))
        && get(/databases/$(database)/documents/agentUsers/$(request.auth.uid)/assignments/$(tenantId)).data.status == 'active';
    }

    function canAccessTenant(tenantId) {
      return membership(tenantId) || agentAssigned(tenantId);
    }

    function tenantData(tenantId) {
      return request.resource.data.tenantId == tenantId;
    }

    function customerReadable(collection) {
      return collection in ['dashboard', 'leads', 'appointments', 'reports', 'billing', 'invoices', 'documents', 'support', 'supportRequests', 'notifications'];
    }

    function staffRole(tenantId) {
      return role(tenantId) in ['admin', 'supervisor', 'agent', 'auditor'];
    }

    function operationalCollection(collection) {
      return collection in ['leads', 'followUpTasks', 'communicationAlerts', 'callRecords', 'callTranscripts', 'callQualityReviews', 'appointments', 'businessOwners', 'reports'];
    }

    function configurationCollection(collection) {
      return collection in ['organizations', 'brands', 'campaigns', 'leadSources', 'scripts', 'qualificationForms', 'routingRules', 'phoneNumbers'];
    }

    match /tenants/{tenantId} {
      allow read: if canAccessTenant(tenantId);
      allow write: if signedIn() && membership(tenantId) && role(tenantId) == 'admin';

      match /members/{uid} {
        allow read: if membership(tenantId) && (uid == request.auth.uid || role(tenantId) == 'admin');
        allow write: if false;
      }

      match /auditLogs/{auditId} {
        allow read: if membership(tenantId);
        allow write: if false;
      }

      match /{collection}/{documentId} {
        allow read: if canAccessTenant(tenantId)
          && collection != 'members'
          && collection != 'auditLogs'
          && (agentAssigned(tenantId) || (membership(tenantId) && (role(tenantId) in ['admin', 'supervisor', 'auditor'] || (role(tenantId) == 'customer' && customerReadable(collection)))));
        allow create: if membership(tenantId)
          && collection != 'members'
          && collection != 'auditLogs'
          && tenantData(tenantId)
          && ((role(tenantId) in ['admin', 'supervisor'] && operationalCollection(collection))
            || (role(tenantId) in ['admin', 'supervisor'] && configurationCollection(collection))
            || (role(tenantId) == 'admin' && collection in ['support', 'documents']));
        allow update: if membership(tenantId)
          && collection != 'members'
          && collection != 'auditLogs'
          && resource.data.tenantId == tenantId
          && tenantData(tenantId)
          && ((role(tenantId) in ['admin', 'supervisor'] && operationalCollection(collection))
            || (role(tenantId) in ['admin', 'supervisor'] && configurationCollection(collection))
            || (role(tenantId) == 'admin' && collection in ['support', 'documents']));
        allow delete: if membership(tenantId)
          && collection != 'members'
          && collection != 'auditLogs'
          && role(tenantId) == 'admin';
      }
    }

    match /agentUsers/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow write: if false;
      match /assignments/{tenantId} {
        allow read: if signedIn() && uid == request.auth.uid;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
