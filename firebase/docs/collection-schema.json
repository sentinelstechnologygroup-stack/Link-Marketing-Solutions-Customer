{
  "tenantRoot": "tenants/{tenantId}",
  "authorizationModel": {
    "customerAccess": "active tenants/{tenantId}/members/{uid} membership",
    "agentAccess": "active agentUsers/{uid}/assignments/{tenantId} assignment",
    "assignmentSource": "agentAssignments/{assignmentId}",
    "clientControlledTenantFields": false,
    "brandAccess": "agent assignment brandId or brandIds must include the record Brand",
    "ingestionOwnership": "server-owned ingestionRoutes/{routeKey}; browser ownership fields are ignored"
  },
  "requiredTenantFields": ["tenantId", "createdAt", "updatedAt"],
  "collections": {
    "organizations": ["name", "status", "settings"],
    "brands": ["name", "status", "domain"],
    "campaigns": ["name", "brandId", "status", "startDate", "endDate"],
    "leadSources": ["name", "type", "status"],
    "leads": ["firstName", "lastName", "email", "phone", "status", "tenantId", "industryId", "sourceId", "campaignId", "brandId", "routingProfileId", "consentPolicyId", "retentionPolicyId", "assignedTo", "receivedAt"],
    "followUpTasks": ["leadId", "assignedTo", "status", "dueAt"],
    "communicationAlerts": ["leadId", "channel", "status", "sentAt"],
    "callRecords": ["leadId", "agentUid", "status", "startedAt", "endedAt"],
    "callTranscripts": ["callId", "storagePath", "status"],
    "callQualityReviews": ["callId", "reviewerUid", "score", "status"],
    "appointments": ["leadId", "title", "scheduledStart", "scheduledEnd", "status", "calendarProvider"],
    "businessOwners": ["leadId", "name", "email", "phone"],
    "scripts": ["name", "status", "body", "version"],
    "qualificationForms": ["name", "status", "fields", "version"],
    "routingRules": ["name", "status", "priority", "conditions", "destination"],
    "phoneNumbers": ["phoneNumber", "provider", "status", "assignedTo"],
    "reports": ["name", "type", "periodStart", "periodEnd", "status", "storagePath"],
    "billing": ["status", "balance", "currency", "currentPeriodStart", "currentPeriodEnd"],
    "invoices": ["invoiceNumber", "status", "amount", "currency", "issuedAt", "dueAt"],
    "documents": ["name", "category", "storagePath", "contentType", "sizeBytes", "status"],
    "supportRequests": ["subject", "category", "status", "priority", "createdBy"],
    "notifications": ["recipientUid", "type", "title", "body", "readAt"],
    "auditLogs": ["actorUid", "action", "target", "metadata", "occurredAt"]
  },
  "storagePaths": {
    "documents": "tenants/{tenantId}/documents/{documentId}/{fileName}",
    "reports": "tenants/{tenantId}/reports/{reportId}/{fileName}",
    "recordings": "tenants/{tenantId}/recordings/{callId}/{fileName}",
    "brandDocuments": "tenants/{tenantId}/brands/{brandId}/documents/{documentId}/{fileName}",
    "brandReports": "tenants/{tenantId}/brands/{brandId}/reports/{reportId}/{fileName}",
    "brandRecordings": "tenants/{tenantId}/brands/{brandId}/recordings/{callId}/{fileName}",
    "exports": "tenants/{tenantId}/brands/{brandId}/exports/{exportId}/{fileName}",
    "invoices": "tenants/{tenantId}/brands/{brandId}/invoices/{invoiceId}/{fileName}",
    "customerUploads": "tenants/{tenantId}/brands/{brandId}/uploads/{documentId}/{fileName}"
  },
  "industryPolicies": {
    "required": ["industryId", "workflowVersion", "scriptSetId", "qualificationFormId", "routingProfileId", "consentPolicyId", "retentionPolicyId"],
    "medical": {"phiEnabled": false, "requiresApproval": true, "minimumNecessary": true}
  }
}
